{
  "compilerOptions": {
    "target": "ES5",
    "baseUrl": "src/",
    "module": "commonjs",
    "moduleResolution": "node",
    "paths": {
      "*": [
        "node_modules/*",
        "src/types/*"
      ]
    },
    "allowJs": false,
    "strict": true,
    "noImplicitAny": true,
    "declaration": true,
    "outDir": "dist",
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "src/**/_test",
    "src/**/*.test.ts"
  ]
}
